# Normalize text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Windows-only formats that expect CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binary files: never touch line endings or diff them as text.
*.bmp binary
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.wav binary
*.zip binary
