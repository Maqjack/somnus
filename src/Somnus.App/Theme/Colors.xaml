<!--
  The Somnus palette, as Mac approved it, and the fonts. This folder is the only place
  that may define colours (rule R-02); views use the brushes below. Contrast is checked by
  ThemeContrastTests: text at least 4.5:1, input borders and the focus ring at least 3:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="BgColor">#1A0F2E</Color>
    <Color x:Key="SurfaceColor">#2A1A4A</Color>
    <Color x:Key="SurfaceInputColor">#3B2566</Color>
    <Color x:Key="BorderColor">#5B3F8C</Color>
    <Color x:Key="InputBorderColor">#8A78B3</Color>
    <Color x:Key="PrimaryColor">#7C3AED</Color>
    <Color x:Key="PrimaryHoverColor">#6D28D9</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#C4B5FD</Color>
    <Color x:Key="TextColor">#F3EEFF</Color>
    <Color x:Key="TextMutedColor">#B9A8E0</Color>
    <Color x:Key="TextDisabledColor">#8A78B3</Color>
    <Color x:Key="WarningColor">#F0ABFC</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12.5</sys:Double>
    <sys:Double x:Key="FontSizeTiny">10</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeCountdown">44</sys:Double>
    <sys:Double x:Key="FontSizeIcon">16</sys:Double>

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
</ResourceDictionary>
