<!--
  The crescent-moon logo as a vector drawing, translated from assets/logo.svg (the source of truth):
  a 102 px circle with a purple gradient, minus an 88 px circle that cuts out the crescent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Keeps the 256 x 256 frame of the SVG so the crescent sits where it does there. -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <!-- The SVG gradient spans the full circle (36..240), so its points are absolute. -->
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="66.6,40.4" EndPoint="209.4,213.8">
                            <GradientStop Offset="0" Color="#DDD6FE" />
                            <GradientStop Offset="0.5" Color="#A78BFA" />
                            <GradientStop Offset="1" Color="#7C3AED" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="138,122" RadiusX="102" RadiusY="102" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="184,86" RadiusX="88" RadiusY="88" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
