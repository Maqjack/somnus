<Application x:Class="Somnus.App.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Somnus.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
            <converters:BooleanToHiddenConverter x:Key="BooleanToHidden" />
            <converters:TextToVisibilityConverter x:Key="TextToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
