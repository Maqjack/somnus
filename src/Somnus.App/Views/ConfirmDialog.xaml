<Window x:Class="Somnus.App.Views.ConfirmDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="clr-namespace:Somnus.App.Behaviors"
        xmlns:services="clr-namespace:Somnus.Presentation.Services;assembly=Somnus.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=services:ConfirmationRequest}"
        b:TextScale.Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource SomnusWindow}">
    <StackPanel Margin="20">
        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,20"
                   FontSize="{DynamicResource FontSizeBody}"
                   Style="{StaticResource MutedText}"
                   Text="{Binding Message}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <!-- The safe answer is the default: Enter and Esc keep things as they are. -->
            <Button Margin="0,0,8,0"
                    Click="OnCancel"
                    Content="{Binding CancelText}"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button Click="OnConfirm"
                    Content="{Binding ConfirmText}"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
