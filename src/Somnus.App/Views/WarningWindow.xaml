<Window x:Class="Somnus.App.Views.WarningWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="clr-namespace:Somnus.App.Behaviors"
        xmlns:l="clr-namespace:Somnus.App.Localization"
        xmlns:vm="clr-namespace:Somnus.Presentation.ViewModels;assembly=Somnus.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WarningViewModel}"
        Title="{l:Tr App_Name}"
        b:TextScale.Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Style="{StaticResource SomnusWindow}">
    <!-- No title bar and no close button: a cross left people unsure whether it stopped the countdown (Mac, 2026-11-04). -->
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="OnDragArea">
        <Grid>
            <StackPanel Margin="24,20,24,20">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Image Width="32" Height="32" Source="{StaticResource LogoImage}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Heading}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="{l:Tr Main_TimeLeft}"
                           Style="{StaticResource CountdownText}"
                           Text="{Binding RemainingText}" />

                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource WarningText}"
                           Text="{l:Tr Main_ForceCloseAppsWarning}"
                           TextAlignment="Center"
                           Visibility="{Binding IsForceWarningVisible, Converter={StaticResource BooleanToVisibility}}" />

                <UniformGrid Margin="0,20,0,0" Columns="2">
                    <!-- Stop is the default and the Esc answer: the safe choice is one key away. -->
                    <Button Margin="0,0,6,0"
                            Command="{Binding CancelCommand}"
                            Content="{l:Tr Warning_Cancel}"
                            IsCancel="True"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Margin="6,0,0,0"
                            Command="{Binding DoItNowCommand}"
                            Content="{l:Tr Warning_DoItNow}"
                            Style="{StaticResource SecondaryButton}" />
                </UniformGrid>
            </StackPanel>

            <!-- Minimize only puts the warning on the taskbar; the countdown goes on. -->
            <Button x:Name="MinimizeButton"
                    Margin="0,4,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{l:Tr Warning_Minimize}"
                    Click="OnMinimizeClick"
                    Content="&#xE921;"
                    Style="{StaticResource IconButton}"
                    ToolTip="{l:Tr Warning_Minimize}" />
        </Grid>
    </Border>
</Window>
