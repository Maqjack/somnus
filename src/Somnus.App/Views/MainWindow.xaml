<Window x:Class="Somnus.App.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="clr-namespace:Somnus.App.Behaviors"
        xmlns:l="clr-namespace:Somnus.App.Localization"
        xmlns:vm="clr-namespace:Somnus.Presentation.ViewModels;assembly=Somnus.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        b:TextScale.Width="380"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource SomnusWindow}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding StartCommand}" />
        <KeyBinding Key="Escape" Command="{Binding RequestCancelCommand}" />
    </Window.InputBindings>

    <!-- The settings panel lies over the countdown controls, which keep their space while hidden (#54). -->
    <Grid>
        <StackPanel x:Name="MainContent" Margin="20,16,20,20" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToHidden}}">
            <!-- Header: logo, name, settings -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="48" Height="48" Source="{StaticResource LogoImage}" AutomationProperties.Name="{l:Tr App_Name}" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TitleText}" Text="{l:Tr App_Name}" />
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{l:Tr Main_SettingsButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Content="&#xE713;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{l:Tr Main_SettingsButton}" />
            </Grid>

            <!-- When: In / At -->
            <Border Margin="0,0,0,14" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource ButtonCornerRadius}">
                <UniformGrid AutomationProperties.Name="{l:Tr Main_ModeGroup}" Columns="2">
                    <RadioButton Content="{l:Tr Main_ModeIn}" GroupName="Mode" IsChecked="{Binding IsInMode}" Style="{StaticResource SegmentRadio}" />
                    <RadioButton Content="{l:Tr Main_ModeAt}" GroupName="Mode" IsChecked="{Binding IsAtMode}" Style="{StaticResource SegmentRadio}" />
                </UniformGrid>
            </Border>

            <!-- In: amount and unit -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInMode, Converter={StaticResource BooleanToVisibility}}">
                <TextBox b:TextScale.Width="76"
                         b:DigitsOnly.IsEnabled="True"
                         b:TypeOver.IsEnabled="True"
                         AutomationProperties.Name="{l:Tr Main_Amount}"
                         HorizontalContentAlignment="Center"
                         MaxLength="6"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox b:TextScale.Width="140"
                          Margin="10,0,0,0"
                          AutomationProperties.Name="{l:Tr Main_Unit}"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding Units}"
                          SelectedValue="{Binding Unit}"
                          SelectedValuePath="Value" />
            </StackPanel>

            <!-- At: hour and minute -->
            <StackPanel Visibility="{Binding IsAtMode, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBox b:TextScale.Width="56"
                             b:DigitsOnly.IsEnabled="True"
                             b:TypeOver.IsEnabled="True"
                             b:TypeOver.Maximum="23"
                             AutomationProperties.Name="{l:Tr Main_Hour}"
                             HorizontalContentAlignment="Center"
                             MaxLength="2"
                             Text="{Binding HourText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeTitle}" Text=":" />
                    <TextBox b:TextScale.Width="56"
                             b:DigitsOnly.IsEnabled="True"
                             b:TypeOver.IsEnabled="True"
                             b:TypeOver.Maximum="59"
                             AutomationProperties.Name="{l:Tr Main_Minute}"
                             HorizontalContentAlignment="Center"
                             MaxLength="2"
                             Text="{Binding MinuteText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource MutedText}"
                           Text="{Binding AtPreview}"
                           Visibility="{Binding AtPreview, Converter={StaticResource TextToVisibility}}" />

                <!-- Repeat: every day or on chosen days (#83) -->
                <CheckBox Margin="0,12,0,0" Content="{l:Tr Main_EveryDay}" IsChecked="{Binding IsEveryDay}" />
                <ItemsControl Margin="-2,8,-2,0"
                              AutomationProperties.Name="{l:Tr Main_RepeatDays}"
                              Focusable="False"
                              ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton AutomationProperties.Name="{Binding FullName}"
                                          Content="{Binding ShortName}"
                                          IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource DayToggle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Inline validation, never a popup -->
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource WarningText}"
                       Text="{Binding InputError}"
                       Visibility="{Binding InputError, Converter={StaticResource TextToVisibility}}" />

            <!-- What: sleep, hibernate, shut down -->
            <StackPanel Margin="0,18,0,0" AutomationProperties.Name="{l:Tr Main_ActionGroup}">
                <RadioButton Content="{l:Tr Action_Sleep}"
                             GroupName="Action"
                             IsChecked="{Binding IsSleepSelected}"
                             IsEnabled="{Binding IsSleepAvailable}"
                             ToolTip="{Binding SleepUnavailableReason}"
                             ToolTipService.ShowOnDisabled="True" />
                <RadioButton Content="{l:Tr Action_Hibernate}"
                             GroupName="Action"
                             IsChecked="{Binding IsHibernateSelected}"
                             IsEnabled="{Binding IsHibernateAvailable}"
                             ToolTip="{Binding HibernateUnavailableReason}"
                             ToolTipService.ShowOnDisabled="True" />
                <RadioButton Content="{l:Tr Action_Shutdown}" GroupName="Action" IsChecked="{Binding IsShutdownSelected}" />
                <CheckBox Margin="28,4,0,0"
                          Content="{l:Tr Main_ForceCloseApps}"
                          IsChecked="{Binding ForceCloseApps}"
                          Visibility="{Binding IsForceOptionVisible, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Margin="56,6,0,0"
                           Style="{StaticResource WarningText}"
                           Text="{l:Tr Main_ForceCloseAppsWarning}"
                           Visibility="{Binding IsForceWarningVisible, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>

            <!-- Countdown while running -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock AutomationProperties.LiveSetting="Off"
                           AutomationProperties.Name="{l:Tr Main_TimeLeft}"
                           Style="{StaticResource CountdownText}"
                           Text="{Binding CountdownText}" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           Text="{Binding TargetText}"
                           TextAlignment="Center" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           Text="{Binding RepeatText}"
                           TextAlignment="Center"
                           Visibility="{Binding RepeatText, Converter={StaticResource TextToVisibility}}" />
                <Border Margin="0,12,0,0"
                        Padding="12,8"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibility}}">
                    <DockPanel>
                        <Button Command="{Binding RestartCommand}"
                                Content="{l:Tr Main_SaveChanges}"
                                DockPanel.Dock="Right"
                                Padding="12,6"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}" Text="{l:Tr Main_PendingChanges}" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Outcome of the last countdown, when it did not run -->
            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource WarningText}"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />

            <!-- Start / Cancel -->
            <Grid Margin="0,20,0,0">
                <Button Command="{Binding StartCommand}"
                        Content="{l:Tr Main_Start}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="{Binding InputError}"
                        ToolTipService.ShowOnDisabled="True"
                        Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibility}}" />
                <Button Command="{Binding CancelCommand}"
                        Content="{l:Tr Main_Cancel}"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </StackPanel>

        <!-- Settings: a language previews as soon as it is picked; Save keeps it, the cross or Esc goes back. -->
        <Border x:Name="SettingsPanel" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel Margin="20,16,20,20"
                       DataContext="{Binding Settings}"
                       d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
                       LastChildFill="False">
                <DockPanel.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                </DockPanel.InputBindings>

                <!-- Save and Cancel sit where Start is, at the bottom of the window. -->
                <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Content="{l:Tr Settings_Cancel}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Command="{Binding SaveCommand}"
                            Content="{l:Tr Settings_Save}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleText}" Text="{l:Tr Settings_Title}" />
                        <Button Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:Tr Settings_Close}"
                                Command="{Binding CancelCommand}"
                                Content="&#xE711;"
                                Style="{StaticResource IconButton}"
                                ToolTip="{l:Tr Settings_Close}" />
                    </Grid>

                    <Label Padding="0" Margin="0,0,0,6" Content="{l:Tr Settings_Language}" Foreground="{StaticResource TextMutedBrush}" Target="{Binding ElementName=LanguageBox}" />
                    <ComboBox x:Name="LanguageBox"
                              b:TextScale.Width="180"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="{l:Tr Settings_Language}"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding Languages}"
                              SelectedValue="{Binding Language}"
                              SelectedValuePath="Value" />

                    <CheckBox Margin="0,18,0,0" Content="{l:Tr Settings_Warning}" IsChecked="{Binding WarningEnabled}" />
                    <CheckBox Margin="0,12,0,0" Content="{l:Tr Settings_RememberLast}" IsChecked="{Binding RememberLast}" />
                    <!-- The sound of the last 20 seconds: the lullaby, none or the user's file (Mac, 2026-11-04). -->
                    <Label Padding="0" Margin="0,18,0,6" Content="{l:Tr Settings_Sound}" Foreground="{StaticResource TextMutedBrush}" Target="{Binding ElementName=SoundBox}" />
                    <ComboBox x:Name="SoundBox"
                              b:TextScale.Width="220"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="{l:Tr Settings_Sound}"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding SoundOptions}"
                              SelectedValue="{Binding Sound}"
                              SelectedValuePath="Value" />
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSoundFileVisible, Converter={StaticResource BooleanToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="{l:Tr Settings_SoundFilePath}"
                                     Text="{Binding SoundFile, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Left"
                                     ToolTip="{Binding SoundFileToolTip}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseSoundFileCommand}"
                                    Content="{l:Tr Settings_Browse}"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="{l:Tr Settings_SoundFileHint}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource WarningText}"
                                   Text="{l:Tr Settings_SoundFileMissing}"
                                   Visibility="{Binding IsSoundFileMissing, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource WarningText}"
                                   Text="{l:Tr Settings_SoundFileBroken}"
                                   Visibility="{Binding IsSoundFileBroken, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <CheckBox Margin="0,18,0,0" Content="{l:Tr Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Margin="28,4,0,0" Style="{StaticResource MutedText}" Text="{l:Tr Settings_StartWithWindowsHint}" />

                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource WarningText}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- A tiny signature in the corner, below the buttons and on top of both layers (#69). -->
        <TextBlock Margin="0,0,12,4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   FontSize="{DynamicResource FontSizeTiny}"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="{l:Tr App_Signature}" />
    </Grid>
</Window>
